---
import SiteLayout from '../layouts/SiteLayout.astro'
import { GetLanguage } from '../lib/localization.ts'
const { Messages } = GetLanguage()
---
<SiteLayout title={Messages.NotFoundTitle} noindex>
  <section class="document">
    <p class="eyebrow">404 / {Messages.NotFoundTitle}</p>
    <h1>{Messages.NotFoundHeading}</h1>
    <p class="lede">{Messages.NotFoundDetails}</p>
    <a class="button-link" href="/">{Messages.Return} <span aria-hidden="true">→</span></a>
  </section>
</SiteLayout>
