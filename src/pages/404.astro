---
import SiteLayout from '../layouts/SiteLayout.astro'
---
<SiteLayout title="Page not found" noindex>
  <section class="document">
    <p class="eyebrow">404 / Page not found</p>
    <h1>This connection leads nowhere.</h1>
    <p class="lede">The page may have moved, or this address may be incomplete.</p>
    <a class="button-link" href="/">Return to the directory <span aria-hidden="true">→</span></a>
  </section>
</SiteLayout>
