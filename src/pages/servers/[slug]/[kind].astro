---
import { render, type CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import SiteLayout from '../../../layouts/SiteLayout.astro'
import { GetCatalog } from '../../../lib/catalog.ts'

export const getStaticPaths = (async () => {
  const { Policies } = await GetCatalog()
  return Policies.map((Policy) => ({
    params: { slug: Policy.data.server, kind: Policy.data.kind },
    props: { policy: Policy },
  }))
}) satisfies GetStaticPaths

interface Props { policy: CollectionEntry<'policies'> }
const { policy: Policy } = Astro.props
const { Content } = await render(Policy)
---
<SiteLayout title={Policy.data.title}>
  <article class="document">
    <a class="back-link" href={`/servers/${Policy.data.server}/`}>← Server documentation</a>
    <header class="document-header"><h1>{Policy.data.title}</h1></header>
    <div class="prose"><Content /></div>
  </article>
</SiteLayout>
