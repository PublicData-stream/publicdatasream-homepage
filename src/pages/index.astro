---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCatalog } from '../lib/catalog.ts';
const { servers } = await getCatalog();
---
<SiteLayout title="Public data server directory">
  <section class="hero" aria-labelledby="hero-title">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> The public data directory</p>
    <h1 id="hero-title">Public data.<br /><span>Ready to connect.</span></h1>
    <p class="hero-description">Discover MCP and API servers from publicdata.stream.<br class="desktop-break" /> Find a service, configure your client, and put public data to work.</p>
    <a class="button-link" href="#servers">Explore the directory <span aria-hidden="true">↘</span></a>
    <div class="hero-rule" aria-hidden="true"><span>Open information. Practical connections.</span><span>01 / DIRECTORY</span></div>
  </section>

  <section id="servers" class="directory" aria-labelledby="servers-title">
    <div class="section-heading">
      <div><p class="eyebrow">Find your connection</p><h2 id="servers-title">Server directory</h2></div>
      <span class="count-label">{servers.length} {servers.length === 1 ? 'server' : 'servers'}</span>
    </div>
    {servers.length === 0 ? (
      <div class="empty-state">
        <span class="empty-mark" aria-hidden="true">[ + ]</span>
        <div><h3>No servers listed yet.</h3><p>Server documentation will appear here as it is added.</p></div>
      </div>
    ) : (
      <ul class="server-grid">
        {servers.map(({ data }) => (
          <li class="server-card">
            <div class="badges">{data.capabilities.map((capability) => <span class="badge">{capability.toUpperCase()}</span>)}</div>
            <h3><a href={`/servers/${data.slug}/`}>{data.name}<span aria-hidden="true"> ↗</span></a></h3>
            <p>{data.description}</p>
            <span class="card-caption">Installation &amp; client configuration</span>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section id="about" class="about" aria-labelledby="about-title">
    <p class="eyebrow">About publicdata.stream</p>
    <div><h2 id="about-title">A clear path from<br />public data to your tools.</h2><p>This directory brings service documentation together in one place: what each server does, how to connect, and where to find its terms and privacy policy.</p></div>
  </section>
</SiteLayout>
