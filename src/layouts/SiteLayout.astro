---
import '../styles/global.css'
import { MarkdownPath } from '../lib/discovery.ts'

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const {
  title: Title,
  description: Description = 'Discover publicdata.stream MCP and API servers, installation instructions, and client configuration.',
  noindex: Noindex = false,
} = Astro.props
const Canonical = new URL(Astro.url.pathname, Astro.site)
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{Title} · publicdata.stream</title>
    <meta name="description" content={Description} />
    <link rel="canonical" href={Canonical} />
    {!Noindex && <link rel="describedby" href="/llms.txt" />}
    {!Noindex && <link rel="alternate" type="text/markdown" href={MarkdownPath(Astro.url.pathname)} />}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/google-sans-flex@5.3.1/index.min.css" />
    {Noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="publicdata.stream home">
          <span class="brand-mark" aria-hidden="true">p<span>·</span></span>
          publicdata<span class="wordmark-suffix">.stream</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/#servers">Servers</a>
          <a href="/#about">About</a>
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <a class="footer-brand" href="/">publicdata.stream</a>
        <span>Public data, connected.</span>
      </footer>
    </div>
  </body>
</html>
