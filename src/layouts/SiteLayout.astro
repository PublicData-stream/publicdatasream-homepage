---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'Discover publicdata.stream MCP and API servers, installation instructions, and client configuration.',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · publicdata.stream</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="publicdata.stream home">
          <span class="brand-mark" aria-hidden="true">p<span>·</span></span>
          publicdata<span class="wordmark-suffix">.stream</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/#servers">Servers</a>
          <a href="/#about">About</a>
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <a class="footer-brand" href="/">publicdata.stream</a>
        <span>Public data, connected.</span>
      </footer>
    </div>
  </body>
</html>
