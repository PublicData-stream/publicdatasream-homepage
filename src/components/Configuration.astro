---
import { GetLanguage } from '../lib/localization.ts'
interface Props {
  title: string;
  example: { format: string; config: string } | { unsupported: string };
  language?: string;
}
const { title: Title, example: Example, language: Language } = Astro.props
const { Messages } = GetLanguage(Language)
---
<section class="configuration" aria-label={Messages.Configuration(Title)}>
  <h3>{Title}</h3>
  {'config' in Example ? (
    <>
      <div class="code-label">{Example.format.toUpperCase()}</div>
      <pre dir="ltr" tabindex="0" aria-label={Messages.ConfigurationExample(Title)}><code>{Example.config}</code></pre>
    </>
  ) : <p>{Example.unsupported}</p>}
</section>
